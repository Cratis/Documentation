{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "comment": "One native DocFX batch groups shared namespaces and extension classes. build-api.mjs first strictly builds these Release assemblies, selects each library's highest available .NET TFM directory, extracts independent per-library audit baselines, then validates the grouped metadata and restores all assembly provenance before rendering. Compiled DLLs avoid the source generators' newer Roslyn requirement.",
      "src": [
        { "files": ["Cratis.Chronicle.dll"], "src": "../../../Chronicle/Source/Clients/DotNET/bin/Release" },
        { "files": ["Cratis.Chronicle.AspNetCore.dll"], "src": "../../../Chronicle/Source/Clients/AspNetCore/bin/Release" },
        { "files": ["Cratis.Chronicle.Testing.dll"], "src": "../../../Chronicle/Source/Clients/Testing/bin/Release" },
        { "files": ["Cratis.Arc.dll"], "src": "../../../Arc/Source/DotNET/Arc/bin/Release" },
        { "files": ["Cratis.Arc.Core.dll"], "src": "../../../Arc/Source/DotNET/Arc.Core/bin/Release" },
        { "files": ["Cratis.Arc.MongoDB.dll"], "src": "../../../Arc/Source/DotNET/MongoDB/bin/Release" },
        { "files": ["Cratis.Fundamentals.dll"], "src": "../../../Fundamentals/Source/DotNET/Fundamentals/bin/Release" }
      ],
      "output": "dotnet",
      "globalNamespaceId": "global"
    }
  ],
  "build": {
    "content": [
      { "files": ["dotnet/**/*.{yml,md}"] },
      { "files": ["toc.yml", "index.md"] }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "postProcessors": ["ExtractSearchIndex"],
    "globalMetadata": {
      "_appTitle": "Cratis API reference",
      "_appName": "Cratis",
      "_enableSearch": true,
      "_disableContribution": true,
      "_appFooter": "Cratis API reference"
    }
  }
}
