---
// Wraps Starlight's PageFrame to add the desktop collapse toggles for the left
// sidebar and the right "On this page" table of contents. Layout is driven by
// `data-sidebar-collapsed` / `data-toc-collapsed` on <html> (set before first
// paint by Head.astro) and the rules in src/styles/cratis.css; the buttons only
// flip those attributes and persist the choice. The sidebar toggle lives here;
// the table of contents toggle lives in PageSidebar.astro, each first in DOM
// order inside the pane it controls. Below Starlight's desktop
// breakpoints the buttons are hidden and nothing changes.
import Default from '@astrojs/starlight/components/PageFrame.astro';

const chevron =
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>';
---

<Default>
    <slot name="header" slot="header" />
    <Fragment slot="sidebar">
        {/* First in the sidebar so Tab reaches it before the navigation links. */}
        <button
            type="button"
            class="cratis-pane-toggle"
            data-cratis-toggle="sidebar"
            aria-label="Navigation sidebar"
            title="Toggle navigation sidebar"
            aria-controls="starlight__sidebar"
            aria-expanded="true"
            set:html={chevron}
        />
        <slot name="sidebar" />
    </Fragment>
    <slot />
</Default>

<script>
    const PANES = {
        sidebar: { attribute: 'data-sidebar-collapsed', key: 'cratis-docs:sidebar-collapsed' },
        toc: { attribute: 'data-toc-collapsed', key: 'cratis-docs:toc-collapsed' },
    } as const;
    type Pane = keyof typeof PANES;

    const root = document.documentElement;
    let animationTimer: number | undefined;

    // The pane's content, and the viewport at which the collapse applies.
    const CONTENT: Record<Pane, { query: string; media: MediaQueryList }> = {
        sidebar: { query: '.sidebar-content > :not([data-cratis-toggle])', media: matchMedia('(min-width: 50rem)') },
        toc: { query: '#cratis-toc-panel', media: matchMedia('(min-width: 72rem)') },
    };

    const isCollapsed = (pane: Pane) => root.hasAttribute(PANES[pane].attribute);

    // Collapsed content is hidden by CSS; `inert` also keeps it out of the tab
    // order and accessibility tree immediately, but only where the collapse applies.
    const syncInert = () => {
        (Object.keys(PANES) as Pane[]).forEach((pane) => {
            const inert = isCollapsed(pane) && CONTENT[pane].media.matches;
            document.querySelectorAll(CONTENT[pane].query).forEach((element) => {
                (element as HTMLElement).inert = inert;
            });
        });
    };

    const sync = () => {
        document.querySelectorAll<HTMLButtonElement>('[data-cratis-toggle]').forEach((button) => {
            button.setAttribute('aria-expanded', String(!isCollapsed(button.dataset.cratisToggle as Pane)));
        });
        syncInert();
    };

    const apply = (pane: Pane, collapsed: boolean, animate: boolean) => {
        // Transitions only run for a deliberate toggle, never on load or resize.
        if (animate && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            root.setAttribute('data-cratis-animating', '');
            window.clearTimeout(animationTimer);
            animationTimer = window.setTimeout(() => root.removeAttribute('data-cratis-animating'), 400);
        }
        // Never leave focus on content that is about to be hidden: move it to the toggle.
        if (collapsed) {
            const active = document.activeElement;
            const toggle = document.querySelector<HTMLElement>(`[data-cratis-toggle="${pane}"]`);
            const focusInside = [...document.querySelectorAll(CONTENT[pane].query)].some((element) => element.contains(active));
            if (toggle && focusInside) toggle.focus();
        }
        root.toggleAttribute(PANES[pane].attribute, collapsed);
        sync();
    };

    document.querySelectorAll<HTMLButtonElement>('[data-cratis-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
            const pane = button.dataset.cratisToggle as Pane;
            const collapsed = !isCollapsed(pane);
            apply(pane, collapsed, true);
            try {
                if (collapsed) localStorage.setItem(PANES[pane].key, '1');
                else localStorage.removeItem(PANES[pane].key);
            } catch {
                // Storage can be unavailable (private mode); the toggle still works for this page.
            }
        });
    });

    // Keep other open tabs in step.
    window.addEventListener('storage', (event) => {
        (Object.keys(PANES) as Pane[]).forEach((pane) => {
            if (event.key === PANES[pane].key) apply(pane, event.newValue === '1', false);
        });
    });

    (Object.keys(CONTENT) as Pane[]).forEach((pane) => CONTENT[pane].media.addEventListener('change', syncInert));
    sync();
</script>
