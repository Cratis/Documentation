---
import { readOrgStats, releaseDate } from '../lib/org-stats.mjs';

interface Props { repository: string | null; }
const { repository } = Astro.props;
const release = readOrgStats()?.repositories.find((repo) => repo.name === repository)?.latestRelease;
---

{release && (
    <p class="last-released">
        <a href={release.url}>Last released <time datetime={release.publishedAt}>{releaseDate(release.publishedAt)}</time> · {release.tag}</a>
    </p>
)}

<style>
    .last-released { margin-block: 0.75rem 0; font-size: var(--sl-text-sm); }
    .last-released a {
        display: inline-block;
        padding: 0.25rem 0.65rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 1rem;
        color: var(--sl-color-accent-high);
        text-decoration: none;
    }
    .last-released a:hover { text-decoration: underline; }
</style>
